# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#   make secret        # prints a value suitable for NUTRILENS_JWT_SECRET

# --- Required -------------------------------------------------------------

# Signs access and refresh tokens. At least 32 characters.
# Changing it invalidates every existing session, which is the intended way to
# force a global sign-out. There is no default outside development: the app
# refuses to start in staging or production without it.
NUTRILENS_JWT_SECRET=

# --- Environment ----------------------------------------------------------

# development | test | staging | production
# Anything production-like additionally refuses SQLite, refuses debug mode and
# hides the interactive API docs.
NUTRILENS_ENVIRONMENT=development

# --- Database -------------------------------------------------------------

NUTRILENS_DATABASE_URL=postgresql+psycopg://nutrilens:nutrilens-local-dev@localhost:5432/nutrilens
NUTRILENS_DATABASE_POOL_SIZE=10
NUTRILENS_DATABASE_MAX_OVERFLOW=20

# Used by docker-compose to provision the local database.
POSTGRES_USER=nutrilens
POSTGRES_PASSWORD=nutrilens-local-dev
POSTGRES_DB=nutrilens
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------

# Optional. Without it, rate limiting falls back to a per-process limiter,
# which is correct for a single worker and documented as such.
NUTRILENS_REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- Security -------------------------------------------------------------

NUTRILENS_ACCESS_TOKEN_TTL_MINUTES=30
NUTRILENS_REFRESH_TOKEN_TTL_DAYS=30
NUTRILENS_PASSWORD_MIN_LENGTH=10

# Comma-separated. Leave empty to send no CORS headers at all, which is correct
# when only the mobile app calls the API.
NUTRILENS_CORS_ALLOW_ORIGINS=

NUTRILENS_RATE_LIMIT_ENABLED=true
NUTRILENS_RATE_LIMIT_REQUESTS=60
NUTRILENS_RATE_LIMIT_WINDOW_SECONDS=60
NUTRILENS_AUTH_RATE_LIMIT_REQUESTS=10
NUTRILENS_AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Media ----------------------------------------------------------------

NUTRILENS_STORAGE_BACKEND=local
NUTRILENS_STORAGE_LOCAL_PATH=./var/meal-images
NUTRILENS_MAX_UPLOAD_BYTES=12582912

# For an S3-backed deployment. Credentials come from the instance role or the
# standard AWS environment variables, never from this file.
NUTRILENS_STORAGE_S3_BUCKET=
NUTRILENS_STORAGE_S3_REGION=

# --- Machine learning -----------------------------------------------------

# auto      prefers ONNX when a model is present, else the classical engine
# onnx      requires a model; refuses to start without one
# heuristic always uses the classical engine
NUTRILENS_ML_ENGINE=auto

# No weights ship with this repository. See docs/ml-pipeline.md.
NUTRILENS_ML_ONNX_MODEL_PATH=
NUTRILENS_ML_ONNX_LABEL_MAP_PATH=

# --- Observability --------------------------------------------------------

NUTRILENS_LOG_LEVEL=INFO
NUTRILENS_LOG_JSON=true

# --- Android release signing ----------------------------------------------
# Read by Gradle from ~/.gradle/gradle.properties or the CI secret store, NOT
# from this file. Listed here so the required names are discoverable.
#
#   NUTRILENS_KEYSTORE_PATH
#   NUTRILENS_KEYSTORE_PASSWORD
#   NUTRILENS_KEY_ALIAS
#   NUTRILENS_KEY_PASSWORD
