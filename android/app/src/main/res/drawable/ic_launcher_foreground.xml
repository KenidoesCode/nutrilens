<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: a plate seen from above with a lens aperture over it.

  Drawn inside the adaptive-icon safe zone (the central 66dp of the 108dp
  canvas, centred at 54,54) so no launcher mask clips it. Vector rather than
  raster so one file serves every density.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Plate -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />

    <!-- Inner rim -->
    <path
        android:fillColor="#2E6B4F"
        android:pathData="M54,54 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0" />

    <!-- Lens aperture -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-10,0 a10,10 0 1,0 20,0 a10,10 0 1,0 -20,0" />
</vector>
