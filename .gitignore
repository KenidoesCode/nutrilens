# --- secrets --------------------------------------------------------------
# .env holds real credentials; only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
keystore.properties
google-services.json

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- android / gradle -----------------------------------------------------
# The wrapper jar and properties ARE tracked: a checkout must be able to build
# without a preinstalled Gradle.
.gradle/
android/build/
android/*/build/
android/*/*/build/
android/local.properties
android/.idea/
android/captures/
*.apk
*.aab
*.ap_
*.dex
*.class
android/app/release/
android/app/debug/

# --- local data -----------------------------------------------------------
var/
*.db
*.sqlite
*.sqlite3
nutrilens.db

# Model weights are not committed; see docs/ml-pipeline.md.
*.onnx
*.tflite
*.pt
*.pth
ml/models/

# --- editors and os -------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
*.swp
*~
